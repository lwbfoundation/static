# Read at runtime by netlify/functions/newsletter-signup.ts, so it also has to
# be set in the Netlify UI. Take the `action` URL out of Mailchimp's embedded
# form code and unescape the `&amp;` it comes with.
MAILCHIMP_FORM_URL=https://[account].[dc].list-manage.com/subscribe/post?u=[user id]&id=[list id]
GATSBY_STRIPE_PUBLISHABLE_KEY=[publishable key from stripe]
GOOGLE_ANALYTICS_TRACKING_ID=UA-XXXXXXXX-X
GATSBY_BASE_URL=http://localhost:8000
GATSBY_API_BASE=http://localhost:3000/dev
